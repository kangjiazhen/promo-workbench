# promo-workbench 的反向代理示例（Caddy v2.7+）
#
# 换成你自己的域名；国内节点记得先做 ICP 备案，否则 80/443 会被拦。
# 先进服务器执行 `caddy hash-password` 生成密码哈希，替换下面的 $2a$14$...。
#
#   sudo caddy hash-password --plaintext '你的密码'
#
# 没有域名、只有公网 IP 时，把站点地址写成 `:8443`（用非标端口），
# Caddy 会自动签一张自签证书，浏览器会提示不受信任 —— 能用，但别长期这么干。

promo.example.com {
	encode zstd gzip

	# 单用户工作台：先挡一层登录。要多人分账号就换成 forward_auth 或 oauth2-proxy。
	basic_auth {
		yg $2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash_password
	}

	# 上传体积：单张默认 ≤30MB，一次拖一整套会连发几百个请求，
	# 单请求上限放到 64MB 足够（这里限制的是单个请求体，不是总量）。
	request_body {
		max_size 64MB
	}

	# API 全部走反代到只监听 127.0.0.1 的 uvicorn
	handle /api/* {
		reverse_proxy 127.0.0.1:8861
	}

	# 前端是纯静态：pnpm build 之后由 Caddy 直接发，
	# 不要在生产环境跑 vite dev server。
	handle {
		root * /opt/promo-workbench/web/dist
		try_files {path} /index.html
		file_server
	}

	# 成片动辄 30MB：让浏览器能断点续传式地拖着播，别整段缓冲
	@videos path /api/video-versions/*
	header @videos Cache-Control "private, max-age=0"

	log {
		output file /var/log/caddy/promo-workbench.log
		format console
	}
}
